{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operation-bindings:v2",
  "title": "Operation Bindings v2",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "bindings"
  ],
  "properties": {
    "format": {
      "const": "operation-bindings"
    },
    "format_version": {
      "const": 2
    },
    "contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context"
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "required": [
        "id",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "priority": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "global": {
          "type": "boolean",
          "default": false
        },
        "isolatesGlobal": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "binding": {
      "type": "object",
      "required": [
        "id",
        "action",
        "context",
        "enabled",
        "input"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "action": {
          "type": "string",
          "pattern": "\\S"
        },
        "context": {
          "type": "string",
          "pattern": "\\S"
        },
        "enabled": {
          "type": "boolean"
        },
        "ignoreRepeat": {
          "type": "boolean",
          "default": false
        },
        "followUpActions": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "input": {
          "$ref": "#/$defs/input"
        }
      }
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "device",
            "code"
          ],
          "properties": {
            "device": {
              "const": "keyboard"
            },
            "code": {
              "type": "string",
              "pattern": "\\S"
            },
            "trigger": {
              "enum": [
                "down",
                "hold"
              ],
              "default": "down"
            },
            "ctrl": {
              "type": "boolean",
              "default": false
            },
            "alt": {
              "type": "boolean",
              "default": false
            },
            "shift": {
              "type": "boolean",
              "default": false
            },
            "meta": {
              "type": "boolean",
              "default": false
            }
          }
        },
        {
          "type": "object",
          "required": [
            "device",
            "button",
            "action"
          ],
          "properties": {
            "device": {
              "const": "mouse"
            },
            "area": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "\\S",
              "description": "Host-defined spatial region; omitted or null matches any region."
            },
            "button": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            },
            "action": {
              "enum": [
                "click",
                "double-click",
                "press",
                "hold"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "device",
            "button",
            "directions",
            "trigger"
          ],
          "properties": {
            "device": {
              "const": "mouse-gesture"
            },
            "button": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            },
            "directions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "enum": [
                  "left",
                  "right",
                  "up",
                  "down"
                ]
              }
            },
            "trigger": {
              "enum": [
                "instant",
                "hold"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "device",
            "direction"
          ],
          "properties": {
            "device": {
              "const": "wheel"
            },
            "direction": {
              "enum": [
                "up",
                "down"
              ]
            },
            "ctrl": {
              "type": "boolean",
              "default": false
            },
            "alt": {
              "type": "boolean",
              "default": false
            },
            "shift": {
              "type": "boolean",
              "default": false
            },
            "meta": {
              "type": "boolean",
              "default": false
            }
          }
        },
        {
          "type": "object",
          "required": [
            "device",
            "gesture",
            "fingers"
          ],
          "properties": {
            "device": {
              "const": "touch"
            },
            "area": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "\\S",
              "description": "Host-defined spatial region; omitted or null matches any region."
            },
            "gesture": {
              "enum": [
                "tap",
                "double-tap",
                "long-press",
                "swipe-left",
                "swipe-right",
                "swipe-up",
                "swipe-down"
              ]
            },
            "fingers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "gesture": {
                    "const": "double-tap"
                  }
                }
              },
              "then": {
                "properties": {
                  "fingers": {
                    "const": 1
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "device",
            "button"
          ],
          "properties": {
            "device": {
              "const": "gamepad"
            },
            "button": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            }
          }
        },
        {
          "type": "object",
          "required": [
            "device",
            "menuId",
            "itemId"
          ],
          "properties": {
            "device": {
              "const": "radial"
            },
            "menuId": {
              "type": "string",
              "minLength": 1
            },
            "itemId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "device",
            "command"
          ],
          "properties": {
            "device": {
              "const": "command"
            },
            "command": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        }
      ]
    }
  }
}
